{
  "manifest_version": 3,
  "name": "Bilibili Audio Only",
  "version": "1.1.0",
  "description": "让 Bilibili 直播使用服务器纯音频流，也支持点播 DASH 音频模式。",
  "minimum_chrome_version": "102",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://live.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bilibili Audio Only：点击切换",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://live.bilibili.com/*",
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/bangumi/play/*"
      ],
      "js": [
        "transform.js",
        "page-hook.js"
      ],
      "css": [
        "audio-only.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://live.bilibili.com/*",
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/bangumi/play/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
